# FolioBeyond Fixed Income Configuration
# Copy this file to .env and customize for your environment

# Base path to SharedFolioBeyond data directory
# This is the root directory containing Investment Strategies, UAData, etc.
FOLIOBEYOND_BASE_PATH=/path/to/your/SharedFolioBeyond

# Optional: Override specific data paths (if different from default structure)
# FOLIOBEYOND_DATA_PATH=/path/to/Investment Strategies/Equity-FixedIncome Blend/Matrix Universe CSV Files
# FOLIOBEYOND_BENCHMARK_PATH=/path/to/UAData/Treesdale
